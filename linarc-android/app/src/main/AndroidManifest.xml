<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Real microphone capture for Voice-to-Log (Capture → Voice daily log). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- In-app CameraX capture (bottom-bar Capture). Camera hardware stays optional so the app
         still installs on camera-less devices; the capture screen degrades to an explain state. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Voice note + Speak: the cloud speech recognizer and the one-time ML Kit EN<->ES model
         download both need the network. Declared here rather than relying on a library merge. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Package visibility (Android 11+): without this, SpeechRecognizer.isRecognitionAvailable()
         returns false on any device whose speech service isn't force-queryable (most non-Pixel
         OEMs), and voice capture reports "not available" even though a recognizer is installed. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">
        <activity
            android:name="com.solomondesign.app.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.App"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>